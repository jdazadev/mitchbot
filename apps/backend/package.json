{
  "name": "@mitchbot/backend",
  "version": "0.13.0",
  "license": "FSL-1.1-ALv2",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"require('fs').cpSync('src/widget/public','dist/widget/public',{recursive:true})\"",
    "start": "node dist/index.js",
    "vapid:generate": "tsx src/scripts/generate-vapid-keys.ts",
    "seed": "tsx src/scripts/seed.ts",
    "migrate:openrouter": "tsx src/scripts/migrate-openrouter.ts",
    "seed:e2e": "tsx src/scripts/seed-e2e.ts",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.1.29",
    "@langchain/openai": "^1.2.11",
    "@langchain/qdrant": "^1.0.1",
    "@qdrant/js-client-rest": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.28.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.21.0",
    "multer": "^2.0.2",
    "pdf-parse": "^2.4.5",
    "pdf-to-img": "^5.0.0",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0",
    "web-push": "3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.10",
    "@types/pdf-parse": "^1.1.5",
    "@types/web-push": "3.6.4",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
