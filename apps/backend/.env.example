# Runtime
PORT=3000
NODE_ENV=development

# Infraestructura
MONGODB_URI=mongodb://localhost:27017/mitchbot
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333

# Proveedor único de IA (OpenRouter)
# La API key NO se guarda en base de datos: proviene exclusivamente de este entorno.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Modelo de chat (requerido, sin valor por defecto). Se resuelve al generar respuestas.
OPENROUTER_LLM_MODEL=
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_OCR_MODEL=google/gemini-3.8-flash
# Opcional: convierte CSV a Markdown vía LLM. Si está vacío, el CSV se indexa crudo.
OPENROUTER_FILE_MODEL=
# Opcional: modelo del re-ranker. Si está vacío, usa OPENROUTER_EMBEDDING_MODEL.
OPENROUTER_RERANKER_MODEL=
# Opcional: modelo para el análisis de conversaciones (insights). Si está vacío, usa OPENROUTER_LLM_MODEL.
OPENROUTER_INSIGHTS_MODEL=

# Dashboard: ventana y timeout del cálculo de métricas de respuesta
DASHBOARD_RESPONSE_CONVERSATION_LIMIT=5000
DASHBOARD_RESPONSE_TIMEOUT_MS=5000

# Auth
JWT_SECRET=change-me

# Frontend
FRONTEND_URL=http://localhost:5173

# Pasarela de canales (opcionales; estos son los valores por defecto)
# Prefijo de colas y estado del circuit breaker en Redis: sepáralo si varios entornos comparten Redis.
CHANNEL_QUEUE_PREFIX=bull
# Envíos máximos por intervalo (ms) en cada canal externo
CHANNEL_WHATSAPP_RATE_MAX=20
CHANNEL_WHATSAPP_RATE_MS=1000
CHANNEL_INSTAGRAM_RATE_MAX=10
CHANNEL_INSTAGRAM_RATE_MS=1000
# Fallos transitorios seguidos que pausan un canal, y cuánto dura la pausa (ms)
CHANNEL_BREAKER_THRESHOLD=5
CHANNEL_BREAKER_COOLDOWN_MS=60000

# Social Gateway (Meta)
# WhatsApp Cloud API: token de sistema, token de verificación del webhook (lo eliges tú)
# y App Secret de la app de Meta (firma de los webhooks). El Phone Number ID se guarda por proyecto.
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# WABA (cuenta de WhatsApp Business) por defecto para las plantillas; cada proyecto puede definir la suya
WHATSAPP_WABA_ID=
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
# Instagram Messaging API: token de la cuenta profesional, token de verificación del webhook
# y App Secret. El ID de la cuenta se guarda por proyecto. Con Facebook Login usa
# INSTAGRAM_API_URL=https://graph.facebook.com.
INSTAGRAM_TOKEN=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_API_URL=https://graph.instagram.com
INSTAGRAM_API_VERSION=v21.0

# Notificaciones push (Web Push). Genera las claves con: pnpm --filter @mitchbot/backend vapid:generate
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@tu-dominio.com
# Proveedores de push extra (host[:puerto], separados por comas); solo para pruebas
PUSH_ALLOWED_HOSTS=
