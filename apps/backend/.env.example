# Runtime
PORT=3000
NODE_ENV=development

# Infraestructura
MONGODB_URI=mongodb://localhost:27017/mitchbot
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333

# Proveedor único de IA (OpenRouter)
# La API key NO se guarda en base de datos: proviene exclusivamente de este entorno.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_OCR_MODEL=google/gemini-3.8-flash

# Auth
JWT_SECRET=change-me

# Frontend
FRONTEND_URL=http://localhost:5173

# Social Gateway (Meta)
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
INSTAGRAM_TOKEN=
INSTAGRAM_VERIFY_TOKEN=
